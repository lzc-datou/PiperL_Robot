/* Only the two standalone PiPER-L windows load this sheet. */
QWidget {
    font-family: "Noto Sans CJK SC", "DejaVu Sans", sans-serif;
    font-size: @BODY@px; color: #222b2a;
    selection-background-color: #5152cc; selection-color: white;
}
QLabel { background: transparent; }
QLabel#title { font-size: 28px; font-weight: 700; }
QLabel#mode, QLabel#indicator, QLabel#caption { font-size: 16px; color: #4e5956; }
QLabel#mode[real="true"] { color: #934e17; font-weight: 700; }
QLabel#sectionTitle { font-size: 24px; font-weight: 600; }
QFrame#rule { border: 0; background: #d1d6d2; max-height: 1px; }
QFrame#surface, QFrame#strip { background: #fdfdfb; border: 1px solid #cdd3cf; border-radius: 8px; }
QFrame#instrument { background: #232c2b; border: 1px solid #222b2a; border-radius: 8px; }
QLabel#onDark { color: #f0f4ef; font-size: 16px; }
QLabel#inputKey { color: #ecf3ee; font-size: 18px; }
QFrame#mapRule { background: #48544e; border: 0; max-height: 1px; }
QLabel#instrumentTitle { color: #f5f6f2; font-weight: 600; font-size: 22px; }
QLabel#lastEvent { color: #f6f7f4; font-weight: 600; font-size: 30px; }
QLabel#eyebrow { color: #bdc9c5; font-size: 18px; }
QLabel#eyebrow[state="danger"] { color: #ffb7af; }
QLabel#eyebrow[state="warning"] { color: #f4d08a; }
QLabel#notice { color: #774b13; font-size: 18px; }
QLabel#status { color: #46514d; font-size: 19px; font-weight: 600; }
QLabel#status[tone="active"] { color: #23694e; }
QLabel#status[tone="warning"] { color: #845000; }
QLabel#status[tone="danger"] { color: #ac233a; }
QPushButton, QComboBox { background: #fdfdfb; border: 1px solid #b8c0bc;
    border-radius: 6px; padding: 5px 14px; min-height: 32px; font-weight: 500; }
QPushButton:hover, QComboBox:hover { background: #efefed; border-color: #7f8a84; }
QPushButton:pressed { background: #e1e1dc; }
QPushButton#primary, QPushButton#connect, QPushButton#enable { background: #5051c9; border-color: #5051c9; color: white; }
QPushButton#primary:hover, QPushButton#connect:hover, QPushButton#enable:hover { background: #4244b1; }
QPushButton#home, QPushButton#reset { min-height: 54px; font-size: 21px; }
QPushButton#enable { min-height: 48px; font-size: 22px; }
QPushButton#stop { min-height: 52px; background: #b9283d; border-color: #ac2935; color: white; font-size: 25px; font-weight: 600; }
QPushButton#stop:hover { background: #a82235; }
QPushButton#stop:pressed { background: #931b2e; }
QPushButton:disabled, QPushButton#primary:disabled, QPushButton#connect:disabled, QPushButton#enable:disabled {
    background: #e2e4e1; color: #6a726e; border-color: #d3d7d3; }
QPushButton#stop:disabled { background: #ecdddf; border-color: #dbc7ca; color: #816368; }
QPushButton:focus, QPushButton#primary:focus, QPushButton#stop:focus, QComboBox:focus,
QToolButton:focus, QSlider:focus { border: 2px solid #8885f4; }
QToolButton { background: transparent; border: 1px solid transparent; border-radius: 4px;
    font-size: 16px; min-height: 30px; padding: 3px 8px; }
QToolButton:hover { background: #e8ebe7; }
QPushButton#modeTab { background: #fbfcf9; color: #343d39; border: 2px solid #c6ccc8;
    border-radius: 6px; padding: 3px 9px; min-height: 30px; font-weight: 600; }
QPushButton#modeTab:enabled:hover { background: #edeefa; border-color: #9695dd; }
QPushButton#modeTab:checked { color: white; background: #5051c9; border-color: #5051c9; }
QPushButton#modeTab:checked:enabled:hover { background: #4244b1; border-color: #4244b1; }
QPushButton#modeTab:enabled:pressed { background: #d9daf4; }
QPushButton#modeTab:checked:enabled:pressed { background: #383a99; }
QPushButton#modeTab:disabled { background: #ebedeb; color: #727a74; border-color: #d4d8d4; }
QPushButton#modeTab:checked:disabled { background: #64689a; border-color: #64689a; color: white; }
QPushButton#modeTab:enabled:focus { border-color: #282b78; }
QPushButton#sessionStatus { background: transparent; border: 1px solid transparent; padding: 0;
    min-height: 60px; max-height: 60px; }
QPushButton#sessionStatus:hover { background: #f0f1f3; }
QPushButton#sessionStatus:focus { border-color: #8885f4; }
QTableWidget#diagnostics { background: #fcfcfa; alternate-background-color: #f1f3ef;
    border: 1px solid #cbd1cb; border-radius: 5px; font-size: 16px; }
QTableWidget#diagnostics QHeaderView::section { background: #e9ede9; border: 0;
    text-align: left; padding: 3px 6px; font-size: 15px; font-weight: 600; }
QFrame#readout, QPushButton#jointTile { background: #f7f8f5; border: 1px solid #d4d9d4; border-radius: 7px; padding: 0; }
QPushButton#jointTile:hover { background: #eeeef9; border-color: #8b8ad4; }
QPushButton#jointTile:checked { background: #5556ce; border-color: #494ab5; }
QPushButton#jointTile:checked:disabled { background: #52578c; border-color: #52578c; }
QPushButton#jointTile:focus { border: 2px solid #7979e9; }
QLabel#axisName { font-weight: 600; font-size: 20px; }
QLabel#reading, QLabel#speedValue { font-family: "DejaVu Sans Mono", monospace; font-size: 34px; }
QLabel#reading[selected="true"] { color: #ffffff; }
QLabel#caption[selected="true"] { color: #ffffff; }
QLabel#tileMark { font-size: 18px; font-weight: 700; }
QLabel[selected="true"] { color: white; }
QLabel#speedValue { font-size: 27px; }
QComboBox { padding-right: 26px; }
QComboBox::drop-down { border: 0; width: 28px; }
QComboBox::down-arrow { image: url(@ASSET@/chevron-down.svg); width: 14px; height: 14px; }
QComboBox QAbstractItemView { background: white; }
QSlider { min-height: 24px; border: 2px solid transparent; border-radius: 3px; }
QSlider::groove:horizontal { height: 5px; background: #d2d3d9; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #5556ce; border-radius: 2px; }
QSlider::handle:horizontal { width: 17px; margin: -7px 0; background: white; border: 2px solid #5556ce; border-radius: 9px; }
QSlider::sub-page:horizontal:disabled { background: #a0a2b5; }
QSlider::handle:horizontal:disabled { border-color: #a0a2b5; }
QScrollArea, QScrollArea > QWidget > QWidget { border: 0; background: transparent; }
QScrollBar:vertical { background: transparent; width: 9px; margin: 0; }
QScrollBar::handle:vertical { background: #b9c3bb; border-radius: 4px; min-height: 28px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QTextEdit { background: #fafbf8; border: 1px solid #cbd1cb; border-radius: 5px; padding: 7px; font-size: 15px; }
QToolTip { background: #293332; color: white; border: 0; padding: 6px; }
